name: Build and push Docker images

on:
  push:
    tags:
      - 'v*.*.*'

jobs:
  docker:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Login to Docker Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ secrets.DOCKER_REPOSITORY }}
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}
      - name: Get version
        id: get_version
        run: echo ::set-output name=version::${GITHUB_REF#refs/tags/v}
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          platforms: linux/amd64
          push: true
          tags: |
            ${{ secrets.DOCKER_REPOSITORY }}/whale-wave/ww-bill/ww-bill-client:${{ steps.get_version.outputs.version }}
            ${{ secrets.DOCKER_REPOSITORY }}/whale-wave/ww-bill/ww-bill-client:latest
  deploy:
    needs: docker
    runs-on: ubuntu-latest
    steps:
      - name: Get version
        id: get_version
        run: echo ::set-output name=version::${GITHUB_REF#refs/tags/v}
      - name: deploy aliyun
        uses: appleboy/ssh-action@master
        env:
          WW_BILL_SERVICE_ENV_OSS_UPYUN_SERVICE_NAME: ${{ secrets.WW_BILL_SERVICE_ENV_OSS_UPYUN_SERVICE_NAME }}
          WW_BILL_SERVICE_ENV_OSS_UPYUN_OPERATOR: ${{ secrets.WW_BILL_SERVICE_ENV_OSS_UPYUN_OPERATOR }}
          WW_BILL_SERVICE_ENV_OSS_UPYUN_PASSWORD: ${{ secrets.WW_BILL_SERVICE_ENV_OSS_UPYUN_PASSWORD }}
          WW_BILL_SERVICE_ENV_OSS_UPYUN_DOMAIN: ${{ secrets.WW_BILL_SERVICE_ENV_OSS_UPYUN_DOMAIN }}
        with:
          host: ${{ secrets.HOST }}
          username: ${{ secrets.USERNAME }}
          key: ${{ secrets.RSA_KEY }}
          port: ${{ secrets.PORT }}
          envs: WW_BILL_SERVICE_ENV_OSS_UPYUN_SERVICE_NAME,WW_BILL_SERVICE_ENV_OSS_UPYUN_OPERATOR,WW_BILL_SERVICE_ENV_OSS_UPYUN_PASSWORD,WW_BILL_SERVICE_ENV_OSS_UPYUN_DOMAIN
          script: |
            cd ${{ secrets.WORK_DIR }}
            export WW_BILL_CLIENT_VERSION=${{ steps.get_version.outputs.version }}

            echo "WW_BILL_CLIENT_VERSION: $WW_BILL_CLIENT_VERSION"

            export WW_BILL_SERVICE_ENV_SECRET=${{ secrets.WW_BILL_SERVICE_ENV_SECRET }}
            export WW_BILL_SERVICE_ENV_EMAIL_PASSWORD=${{ secrets.WW_BILL_SERVICE_ENV_EMAIL_PASSWORD }}
            export WW_BILL_SERVICE_ENV_OSS_ALI_REGION=${{ secrets.WW_BILL_SERVICE_ENV_OSS_ALI_REGION }}
            export WW_BILL_SERVICE_ENV_OSS_ALI_BUCKET=${{ secrets.WW_BILL_SERVICE_ENV_OSS_ALI_BUCKET }}
            export WW_BILL_SERVICE_ENV_OSS_ALI_ACCESS_KEY_ID=${{ secrets.WW_BILL_SERVICE_ENV_OSS_ALI_ACCESS_KEY_ID }}
            export WW_BILL_SERVICE_ENV_OSS_ALI_ACCESS_KEY_SECRET=${{ secrets.WW_BILL_SERVICE_ENV_OSS_ALI_ACCESS_KEY_SECRET }}
            export WW_BILL_SERVICE_ENV_ORM_HOST=${{ secrets.WW_BILL_SERVICE_ENV_ORM_HOST }}
            export WW_BILL_SERVICE_ENV_ORM_USERNAME=${{ secrets.WW_BILL_SERVICE_ENV_ORM_USERNAME }}
            export WW_BILL_SERVICE_ENV_ORM_PASSWORD=${{ secrets.WW_BILL_SERVICE_ENV_ORM_PASSWORD }}
            export WW_BILL_SERVICE_ENV_ORM_DATABASE=${{ secrets.WW_BILL_SERVICE_ENV_ORM_DATABASE }}
            export WW_BILL_SERVICE_ENV_DEFAULT_ADMIN_USERNAME=${{ secrets.WW_BILL_SERVICE_ENV_DEFAULT_ADMIN_USERNAME }}
            export WW_BILL_SERVICE_ENV_DEFAULT_ADMIN_PASSWORD=${{ secrets.WW_BILL_SERVICE_ENV_DEFAULT_ADMIN_PASSWORD }}

            bash deploy.sh
